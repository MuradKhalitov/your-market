YOURMARKET_IMAGE=docker.io/username/your-market:latest

POSTGRES_DB=your_market
POSTGRES_USER=your_market
POSTGRES_PASSWORD=CHANGE_ME

TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_USERNAME=
TELEGRAM_CHANNEL_URL=

PUBLICATION_PRICE_STARS=1
PAYMENTS_ENABLED=false
PUBLICATION_MODERATION_ENABLED=false
TELEGRAM_MODERATION_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=

ADMIN_API_KEY=CHANGE_ME

TELEGRAM_RATE_LIMIT_ENABLED=true
TELEGRAM_RATE_LIMIT_MAX_ACTIONS=20
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60

# Docker runtime limits: suitable defaults for a 2 GB VPS. Increase for a 4 GB VPS.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=1.0
APP_MEM_LIMIT=768m
APP_CPUS=1.0
