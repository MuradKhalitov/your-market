# Docker image
YOURMARKET_IMAGE=muradkhalitov/your-market:staging
SPRING_PROFILES_ACTIVE=production

# PostgreSQL
POSTGRES_DB=your_market
POSTGRES_USER=your_market
POSTGRES_PASSWORD=CHANGE_ME
DB_URL=jdbc:postgresql://postgres:5432/your_market
DB_USERNAME=your_market
DB_PASSWORD=CHANGE_ME

# Telegram bot
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=CHANGE_ME

# Telegram channel
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_CHANNEL_USERNAME=your_channel
TELEGRAM_CHANNEL_URL=https://t.me/your_channel

# Publication
PAYMENTS_ENABLED=false
PUBLICATION_PRICE_STARS=1
PUBLICATION_LIFETIME_DAYS=30
PUBLICATION_EXPIRATION_CRON=0 0 * * * *
PUBLICATION_EXPIRATION_CLAIM_TIMEOUT_SECONDS=600
PUBLICATION_DELETE_CLAIM_TIMEOUT_SECONDS=180

# Moderation
PUBLICATION_MODERATION_ENABLED=false
TELEGRAM_MODERATION_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=

# Admin API
ADMIN_API_KEY=CHANGE_ME

# Rate limit
TELEGRAM_RATE_LIMIT_ENABLED=true
TELEGRAM_RATE_LIMIT_MAX_ACTIONS=100
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60
TELEGRAM_RATE_LIMIT_RETENTION_HOURS=24
TELEGRAM_RATE_LIMIT_CLEANUP_BATCH_SIZE=500
TELEGRAM_RATE_LIMIT_CLEANUP_MAX_BATCHES=10
TELEGRAM_RATE_LIMIT_CLEANUP_CRON=0 0 3 * * *
